clear all; close all; clc; % Clear workspace, close figures, clear command window
% Speaker Identification Using Pitch and MFCC (KNN vs GMM)

%% 1) Setup and Data Loading
dataFolder = 'C:\Users\User\Desktop\VSI\timit\'; % Define the path to the TIMIT dataset
ads = timitHelper(dataFolder); % Create an audioDatastore using the helper function

% --- NEW: Randomly select 5 speakers to meet assignment requirements ---
allLabels = ads.Labels; % Get all labels in the dataset
uniqueLabelsAll = unique(allLabels); % Find all unique speakers

rng('shuffle'); % Ensure random selection is different every time the script runs
random5Speakers = uniqueLabelsAll(randperm(length(uniqueLabelsAll), 5)); % Pick 5 random speakers

disp('--- Selected 5 Random Speakers ---');
disp(random5Speakers);

% Filter the datastore to ONLY include the 5 randomly selected speakers (50 files total)
idxKeep = ismember(allLabels, random5Speakers);
ads = subset(ads, idxKeep); 
% -----------------------------------------------------------------------

% Requirement: 6 files for training (60%), 4 for testing (40%) per speaker
[adsTrain, adsTest] = splitEachLabel(ads, 0.6); % Split the data into 60% training and 40% testing
[sampleTrain, dsInfo] = read(adsTrain); % Read one sample to get metadata
fs = dsInfo.SampleRate; % Extract the sampling rate (usually 16kHz for TIMIT)
reset(adsTrain); % Reset datastore pointer to the beginning after reading

%% 2) Feature Extraction Setup
windowLength = round(0.03*fs); % Set window length to 30ms for quasi-stationary speech
overlapLength = round(0.025*fs); % Set overlap to 25ms (5ms hop size) for high resolution
afe = audioFeatureExtractor(SampleRate=fs, ... % Initialize feature extractor object
    Window=hamming(windowLength,"periodic"), OverlapLength=overlapLength, ... % Use Hamming window to reduce side-lobes
    zerocrossrate=true, shortTimeEnergy=true, pitch=true, mfcc=true); % Enable ZCR, Energy, Pitch, and MFCCs
disp('--- Feature Map ---'); % Header for the feature map
featureMap = info(afe) % Display the indices of extracted features in the command window
energyThreshold = 0.005; % Define minimum energy to distinguish speech from silence
zcrThreshold = 0.2; % Define maximum zero-crossing rate for voiced speech detection

%% 3a) Extract Features (TRAINING SET)
disp('Extracting Training Features...'); % Status update
featuresTrain = []; labelsTrain = []; % Initialize empty arrays for training data
allFeaturesTrain = extract(afe, adsTrain); % Extract raw features from all training files
allLabelsTrain = adsTrain.Labels; % Get categorical labels for training files
for ii = 1:numel(allFeaturesTrain) % Loop through every training audio file
    thisFeature = allFeaturesTrain{ii}; % Get the feature matrix for the current file
    isSpeech = thisFeature(:,featureMap.shortTimeEnergy) > energyThreshold; % Filter frames based on energy
    isVoiced = thisFeature(:,featureMap.zerocrossrate) < zcrThreshold; % Filter frames based on voicing
    voicedSpeech = isSpeech & isVoiced; % Keep frames that are both speech and voiced
    thisFeature(~voicedSpeech,:) = []; % Remove unvoiced/silent frames from the matrix
    thisFeature(:,[featureMap.zerocrossrate,featureMap.shortTimeEnergy]) = []; % Drop ZCR and Energy from the final set
    
    label = repelem(allLabelsTrain(ii), size(thisFeature,1)); % Match labels to every remaining frame
    featuresTrain = [featuresTrain; thisFeature]; % Append frames to the master feature matrix
    labelsTrain = [labelsTrain, label]; % Append labels to the master label array
end % End of training feature extraction loop
% Normalize (Z-Score) based on Training Data
M = mean(featuresTrain, 1); % Calculate mean of each feature
S = std(featuresTrain, [], 1); % Calculate standard deviation of each feature
featuresTrain = (featuresTrain - M) ./ S; % Standardize training data (mean=0, std=1)

%% 3b) Extract Features (TESTING SET)
disp('Extracting Testing Features...'); % Status update
featuresTest = []; labelsTestFrames = []; numVectorsPerFile = []; % Initialize arrays for testing
allFeaturesTest = extract(afe, adsTest); % Extract raw features from all test files
allLabelsTest = adsTest.Labels; % Get categorical labels for test files
for ii = 1:numel(allFeaturesTest) % Loop through every test audio file
    thisFeature = allFeaturesTest{ii}; % Get the feature matrix for the current file
    isSpeech = thisFeature(:,featureMap.shortTimeEnergy) > energyThreshold; % Apply energy filter
    isVoiced = thisFeature(:,featureMap.zerocrossrate) < zcrThreshold; % Apply ZCR filter
    voicedSpeech = isSpeech & isVoiced; % Identify valid frames
    thisFeature(~voicedSpeech,:) = []; % Discard invalid frames
    numVec = size(thisFeature,1); % Count how many frames remain for this file
    thisFeature(:,[featureMap.zerocrossrate,featureMap.shortTimeEnergy]) = []; % Drop temp features
    
    label = repelem(allLabelsTest(ii), numVec); % Match labels to test frames
    numVectorsPerFile = [numVectorsPerFile, numVec]; % Store frame count per file for majority voting later
    featuresTest = [featuresTest; thisFeature]; % Append frames to test matrix
    labelsTestFrames = [labelsTestFrames, label]; % Append labels to test array
end % End of test feature extraction loop
featuresTest = (featuresTest - M) ./ S; % Standardize test data using training parameters

%% --- FEATURE IMPORTANCE ---
disp('Calculating Feature Importance...'); % Status update
[idx,scores] = fscmrmr(featuresTrain, labelsTrain'); % Use MRMR algorithm to rank feature relevance
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window with specific size/position
bar(scores(idx)); % Plot importance scores
xlabel('Features'); ylabel('Importance Score'); title('Feature Importance Analysis'); % Add labels and title
xticks(1:length(idx)); xticklabels(idx); xtickangle(45); % Format X-axis with feature indices
drawnow; % Force MATLAB to render the figure immediately

%% 4) CLASSIFICATION ALGORITHM 1: KNN
disp('Processing KNN Algorithm...'); % Status update
trainedClassifier = fitcknn(featuresTrain, labelsTrain', ... % Train the KNN model
    Distance="euclidean", NumNeighbors=5, DistanceWeight="squaredinverse", ... % Set Euclidean distance and 5 neighbors
    Standardize=false, ClassNames=unique(labelsTrain')); % Use existing standardization; define classes

% KNN 5-Fold Cross-Validation
k = 5; % Set number of folds
c = cvpartition(labelsTrain', KFold=k); % Create stratified partition
partitionedModel = crossval(trainedClassifier, CVPartition=c); % Perform cross-validation
knnValAcc = (1 - kfoldLoss(partitionedModel, LossFun="ClassifError")) * 100; % Calculate validation accuracy percentage
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window
knnValPreds = kfoldPredict(partitionedModel); % Get predictions for validation set
confusionchart(labelsTrain', knnValPreds, title="KNN Validation Accuracy", ... % Plot confusion chart
    ColumnSummary="column-normalized", RowSummary="row-normalized"); % Add summaries
drawnow; % Render figure

% KNN Testing (Per Frame)
predictionFramesKNN = predict(trainedClassifier, featuresTest); % Classify every test frame
predictionFramesKNN = categorical(string(predictionFramesKNN)); % Convert to categorical for processing
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window.
confusionchart(categorical(string(labelsTestFrames')), categorical(string(predictionFramesKNN)), ...
    title="KNN Test Accuracy (Per Frame)", ... % Plot test results.
    ColumnSummary="column-normalized", RowSummary="row-normalized");
drawnow; % Render figure.

% KNN Testing (Per File)
predictedFilesKNN = adsTest.Labels; % Preallocate file labels
idxIter = 1; % Initialize iterator
for ii = 1:numel(adsTest.Files) % Loop through test files
    predictedFilesKNN(ii) = mode(predictionFramesKNN(idxIter : idxIter+numVectorsPerFile(ii)-1)); % Majority vote
    idxIter = idxIter + numVectorsPerFile(ii); % Move to next file's frames
end
knnTestAcc = (sum(predictedFilesKNN == adsTest.Labels) / numel(adsTest.Labels)) * 100; % Calculate final accuracy
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window
confusionchart(adsTest.Labels, predictedFilesKNN, title="KNN Test Accuracy (Per File)", ... % Plot test results
    ColumnSummary="column-normalized", RowSummary="row-normalized");
drawnow; % Render figure

%% 5) CLASSIFICATION ALGORITHM 2: GMM
disp('Processing GMM Algorithm...'); % Status update
uniqueLabels = unique(labelsTrain'); % Identify unique speakers
numLabels = length(uniqueLabels); % Count speakers

% GMM 5-Fold Validation (Manual Implementation)
options = statset('MaxIter', 1000); % Set EM algorithm limit to 1000 iterations
gmmValPreds = labelsTrain'; % Preallocate validation predictions
for f = 1:k % Loop through folds
    trainIdx = training(c, f); valIdx = test(c, f); % Get indices for this fold
    X_train_fold = featuresTrain(trainIdx, :);
    Y_train_fold = labelsTrain(trainIdx);
    X_val_fold = featuresTrain(valIdx, :);
    
    % Train models for this fold
    tempModels = cell(numLabels, 1);
    for i = 1:numLabels
        spkData = X_train_fold(Y_train_fold' == uniqueLabels(i), :);
        tempModels{i} = fitgmdist(spkData, 3, 'Replicates', 2, 'RegularizationValue', 0.01, 'Options', options);
    end
    
    % Predict on the validation fold
    fold_lik = zeros(size(X_val_fold, 1), numLabels);
    for i = 1:numLabels
        fold_lik(:, i) = pdf(tempModels{i}, X_val_fold);
    end
    [~, mIdx] = max(fold_lik, [], 2);
    gmmValPreds(valIdx) = uniqueLabels(mIdx);
end
gmmValAcc = (sum(gmmValPreds == labelsTrain') / length(labelsTrain)) * 100; % Calculate GMM validation percentage
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window
confusionchart(labelsTrain', gmmValPreds, title="GMM Validation Accuracy", ... % Plot GMM validation chart
    ColumnSummary="column-normalized", RowSummary="row-normalized");
drawnow; % Render figure

% Final Training GMM on all training data
gmModels = cell(numLabels, 1);
for i = 1:numLabels
    X_label = featuresTrain(labelsTrain' == uniqueLabels(i), :);
    gmModels{i} = fitgmdist(X_label, 3, 'Replicates', 3, 'RegularizationValue', 0.01, 'Options', options);
end

% GMM Testing (Per Frame)
likelihoods = zeros(size(featuresTest, 1), numLabels); % Initialize likelihood matrix for test set
for i = 1:numLabels % Loop through speakers
    likelihoods(:, i) = pdf(gmModels{i}, featuresTest); % Calculate likelihoods
end
[~, maxIdx] = max(likelihoods, [], 2); % Get frame-level winner
predictionFramesGMM = uniqueLabels(maxIdx); % Assign frame labels
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window
confusionchart(categorical(string(labelsTestFrames')), categorical(string(predictionFramesGMM)), ...
    title="GMM Test Accuracy (Per Frame)", ...% Plot results
    ColumnSummary="column-normalized", RowSummary="row-normalized");
drawnow; % Render figure

% GMM Testing (Per File)
predictedFilesGMM = adsTest.Labels; % Preallocate
idxIter = 1; % Reset iterator
for ii = 1:numel(adsTest.Files) % Loop through test files
    predictedFilesGMM(ii) = mode(predictionFramesGMM(idxIter : idxIter+numVectorsPerFile(ii)-1)); % Majority vote
    idxIter = idxIter + numVectorsPerFile(ii); % Move to next file
end
gmmTestAcc = (sum(predictedFilesGMM == adsTest.Labels) / numel(adsTest.Labels)) * 100; % Final GMM accuracy
figure(Units="normalized",Position=[0.4 0.4 0.4 0.4]); % Create window
confusionchart(adsTest.Labels, predictedFilesGMM, title="GMM Test Accuracy (Per File)", ... % Plot results
    ColumnSummary="column-normalized", RowSummary="row-normalized");
drawnow; % Render figure

%% 6) FINAL OUTPUT SUMMARY
fprintf('\n================ RESULTS SUMMARY ================\n'); % Print header
fprintf('KNN: Validation Acc = %.2f%% | Test Acc = %.2f%%\n', knnValAcc, knnTestAcc); % Output KNN stats
fprintf('GMM: Validation Acc = %.2f%% | Test Acc = %.2f%%\n', gmmValAcc, gmmTestAcc); % Output GMM stats
fprintf('==================================================\n'); % Print footer

%% 7) INTERACTIVE MANUAL TESTING
disp('Entering Manual Test Mode (Type 0 to exit loop)...'); % Header

% Dynamically pull the 20 test files corresponding to the 5 random speakers
testFilesList = adsTest.Files; 
testLabelsList = adsTest.Labels;

fprintf('There are %d test files loaded from your 5 chosen speakers.\n', length(testFilesList));

while true % Start infinite loop for testing
    sel = input(sprintf('\nEnter wav index (1 to %d, or 0 to exit): ', length(testFilesList))); % Ask for user input
    if isempty(sel) || sel == 0, break; end % Exit if 0
    if sel < 1 || sel > length(testFilesList)
        disp('Invalid index. Try again.'); 
        continue; 
    end
    
    strWav = testFilesList{sel}; % Dynamically grab the exact filepath
    actualLabel = testLabelsList(sel); % Grab the true speaker name
    
    [aIn, fsIn] = audioread(strWav); % Read audio file
    mFeat = extract(afe, aIn); % Extract features
    tFeat = []; % Initialize matrix
    for i = 1:size(mFeat,1) % Filter manually tested file
        thisF = mFeat(i,:); % Current frame
        if thisF(:,featureMap.shortTimeEnergy) > energyThreshold && thisF(:,featureMap.zerocrossrate) < zcrThreshold % Check VAD
            thisF(:,[featureMap.zerocrossrate,featureMap.shortTimeEnergy]) = []; % Remove temp features
            tFeat = [tFeat; thisF]; % Add to matrix
        end
    end
    
    if isempty(tFeat)
        disp('No speech detected in this file.'); continue;
    end
    
    tFeat = (tFeat - M) ./ S; % Standardize using training mean/std
    pKNN = mode(categorical(string(predict(trainedClassifier, tFeat)))); % Predict with KNN
    lGMM = zeros(size(tFeat, 1), numLabels); % Likelihoods for GMM
    for i = 1:numLabels, lGMM(:, i) = pdf(gmModels{i}, tFeat); end % Compute
    [~, mIdxT] = max(lGMM, [], 2); % Find winner
    pGMM = mode(uniqueLabels(mIdxT)); % Majority vote for GMM
    
    % Print clean results to command window
    [~, filename, ext] = fileparts(strWav); 
    fprintf('\nFile Tested: %s%s\n', filename, ext);
    fprintf('TRUE Speaker: %s\n', string(actualLabel));
    fprintf(' KNN Predict: %s\n', string(pKNN));
    fprintf(' GMM Predict: %s\n', string(pGMM));
    disp('--------------------------------------------------');
end % End loop